# ─────────────────────────────────────────────────────────────
# Arcana — local profile (FYP 1 PoC / day-to-day dev)
#
# Copy to api/.env and fill in the three REQUIRED keys for the
# first P0 demo:  ANTHROPIC_API_KEY · OPENAI_API_KEY · PINECONE_*
#
# Full guide: docs/env_generation_guide.md
# Never commit a populated .env (NFR-SEC-03).
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# CORE / PROFILE
# ─────────────────────────────────────────────────────────────
ENV=local                                   # local | study | prod-design
GRAPH_BACKEND=networkx                      # networkx | neo4j
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# LLM — PRIMARY (Anthropic Claude)         [REQUIRED]
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_PRIMARY=claude-sonnet                   # model string used by LLMService
LLM_PRIMARY_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────
# LLM — FALLBACK (OpenRouter)              [RECOMMENDED]
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
LLM_FALLBACK=openrouter/auto

# ─────────────────────────────────────────────────────────────
# EMBEDDINGS (OpenAI)                      [REQUIRED]
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large      # 3072-dim — must match the VERA AI baseline (R-02)

# ─────────────────────────────────────────────────────────────
# VECTOR STORE (Pinecone)                  [REQUIRED]
# ─────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=arcana                       # create with dimension=3072, metric=cosine
PINECONE_ENVIRONMENT=                       # serverless region, e.g. us-east-1

# ─────────────────────────────────────────────────────────────
# KNOWLEDGE GRAPH (Neo4j)                  [OPTIONAL — only when GRAPH_BACKEND=neo4j]
# ─────────────────────────────────────────────────────────────
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ─────────────────────────────────────────────────────────────
# FIREBASE (Auth + Firestore)              [P1; STUBBABLE in P0 per env guide §2.6]
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# ─────────────────────────────────────────────────────────────
# ACADEMIC PAPER DISCOVERY                  [OPTIONAL — Web Search Agent, P1]
# ─────────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ─────────────────────────────────────────────────────────────
# RETRIEVAL / PIPELINE TUNING (defaults shown)
# ─────────────────────────────────────────────────────────────
RRF_K=60                                    # Reciprocal Rank Fusion constant (§10.4)
MAX_TOOLS_PER_PROMPT=12                     # intent-scoping cap (§11.5)
HOP_BUDGET=4                                # max agent-to-agent recursion depth (§11.6, Q-09)
TOKEN_BUDGET_PER_TURN=60000                 # cost guard; downgrade then hard-stop (R-03, Q-09)

# ─────────────────────────────────────────────────────────────
# OBJECT STORAGE                           [P1; local DocStore stub uses STORAGE_BUCKET as a directory]
# ─────────────────────────────────────────────────────────────
STORAGE_BUCKET=                             # Firebase Storage bucket OR local path (e.g. infra/local_storage)
