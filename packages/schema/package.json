{
  "name": "@arcana/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for types that cross the wire between api/ and web/.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx codegen/to_python.ts",
    "codegen:check": "tsx codegen/to_python.ts --check",
    "lint": "echo '(@arcana/schema) lint configured later'",
    "test": "echo '(@arcana/schema) tests configured later'"
  },
  "devDependencies": {
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
