# ─── Env / secrets — NEVER commit  (NFR-SEC-03) ───────────
.env
.env.local
.env.*.local
api/.env
web/.env.local
service-account*.json
google-credentials*.json
firebase-adminsdk-*.json

# ─── Local storage (filesystem DocStore stub) ─────────────
infra/local_storage/

# ─── LLM dev cache (Completion.model_dump_json on disk) ───
.llm_cache/

# ─── IDE / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ─── Per-developer Claude Code overrides (never commit) ───
.claude/settings.local.json

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/

# NOTE: api/genui/_generated.py is COMMITTED — codegen:check
